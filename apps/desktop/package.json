{
  "name": "zhixu-workbench-desktop",
  "productName": "Zhixu Workbench",
  "version": "0.1.0",
  "description": "知序个人 AI 工作台桌面端",
  "private": true,
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "contracts:types": "node scripts/generate-contract-types.mjs",
    "contracts:types:check": "node scripts/generate-contract-types.mjs --check",
    "pretest:e2e": "npm run package",
    "test:e2e": "node scripts/run-playwright.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
